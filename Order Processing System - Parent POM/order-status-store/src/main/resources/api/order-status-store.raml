#%RAML 1.0
title: Order Status Store API
version: 1.0.0
baseUri: http://localhost:8086/api/v1/status
protocols: [HTTP]
mediaType: application/json

uses:
  common: ../../../raml-library/src/main/resources/raml/types/common-types.raml
  traits: ../../../raml-library/src/main/resources/raml/traits/common-traits.raml

/{orderId}:
  uriParameters:
    orderId:
      type: string
      required: true
      description: Unique order identifier

  put:
    displayName: Update Order Status
    description: Update the current status of an order
    is: [traits.correlationIdHeader, traits.errorResponses]
    body:
      application/json:
        type: object
        properties:
          status:
            type: common.OrderStatus
            required: true
          timestamp:
            type: string
            format: date-time
            required: false
    responses:
      200:
        description: Status updated successfully
        body:
          application/json:
            type: common.StatusCheckResponse
      400:
        description: Invalid status update request
        body:
          application/json:
            type: common.ErrorResponse
      404:
        description: Order not found
        body:
          application/json:
            type: common.ErrorResponse

  get:
    displayName: Get Order Status
    description: Retrieve the current status of an order
    is: [traits.correlationIdHeader, traits.errorResponses]
    responses:
      200:
        description: Status retrieved successfully
        body:
          application/json:
            type: common.StatusCheckResponse
      404:
        description: Order not found
        body:
          application/json:
            type: common.ErrorResponse
