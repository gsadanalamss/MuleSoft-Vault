#%RAML 1.0
title: Order Experience API
version: 1.0.0
baseUri: http://localhost:8081/api/v1/orders
protocols: [HTTP]
mediaType: application/json

uses:
  common: ../../../raml-library/src/main/resources/raml/types/common-types.raml
  traits: ../../../raml-library/src/main/resources/raml/traits/common-traits.raml

/orders:
  post:
    displayName: Create Order
    description: Submit a new order for processing
    is: [traits.correlationIdHeader, traits.asyncResponse, traits.errorResponses]
    body:
      application/json:
        type: common.OrderRequest
    responses:
      202:
        description: Order accepted for processing
        body:
          application/json:
            type: common.OrderResponse
      400:
        description: Invalid order request
        body:
          application/json:
            type: common.ErrorResponse

  /{orderId}:
    uriParameters:
      orderId:
        type: string
        required: true
        description: Unique order identifier
    
    /status:
      get:
        displayName: Get Order Status
        description: Retrieve current status of an order
        is: [traits.correlationIdHeader, traits.errorResponses]
        responses:
          200:
            description: Order status retrieved successfully
            body:
              application/json:
                type: common.StatusCheckResponse
          404:
            description: Order not found
            body:
              application/json:
                type: common.ErrorResponse
